{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rahimchcken.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rahimchcken.onrender.com/uploads/:path*"
    }
  ]
}
